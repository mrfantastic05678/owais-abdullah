<!--
  Fluid Distortion Effect — Shopify Online Store 2.0 section
  Renders a full-screen 3D scene with fluid post-processing distortion.
  Dependencies (loaded via CDN): three, postprocessing.
  ⚠️ The GLB model must be uploaded to Shopify Files and its URL pasted in the theme settings.
  Falls back to a TorusKnot geometry when no model URL is provided.
-->
{{ 'fluid-distortion.css' | asset_url | stylesheet_tag }}

<header class="fluid-hero">
  <div class="fluid-hero__canvas" id="fluid-canvas-{{ section.id }}"></div>
  <div class="fluid-hero__content">
    <div class="fluid-hero__left">
      <h1 class="fluid-hero__title">
        {{ section.settings.heading_left | default: 'smoke fluid' | newline_to_br }}
      </h1>
      <p class="fluid-hero__desc">{{ section.settings.description }}</p>
    </div>
    <h1 class="fluid-hero__title fluid-hero__title--right">
      {{ section.settings.heading_right | default: 'beyond reality' | newline_to_br }}
    </h1>
  </div>
</header>

<script>
(function() {
  const container = document.getElementById('fluid-canvas-{{ section.id }}');
  if (!container) return;

  const isDark = {{ section.settings.fluid_color | default: '#1b1b1b' | json }};
  const curlVal = {{ section.settings.curl | default: 30 | json }};
  const modelUrl = {{ section.settings.model_url | default: '' | json }};
  const colorVal = {{ section.settings.accent_color | default: '#9977ff' | json }};

  const script = document.createElement('script');
  script.type = 'importmap';
  script.textContent = JSON.stringify({
    imports: {
      'three': 'https://unpkg.com/three@0.184.0/build/three.module.js',
      'three/addons/': 'https://unpkg.com/three@0.184.0/examples/jsm/'
    }
  });
  document.head.appendChild(script);

  const main = document.createElement('script');
  main.type = 'module';
  main.textContent = `
    import * as THREE from 'three';
    import { OrbitControls } from 'three/addons/controls/OrbitControls.js';

    const container = document.getElementById('fluid-canvas-{{ section.id }}');
    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x000000);

    const camera = new THREE.PerspectiveCamera(50, container.clientWidth / container.clientHeight, 0.1, 100);
    camera.position.set(0, 0, 6);

    const renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setSize(container.clientWidth, container.clientHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.2;
    container.appendChild(renderer.domElement);

    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.05;
    controls.enableZoom = false;
    controls.autoRotate = true;
    controls.autoRotateSpeed = 0.8;

    const hemiLight = new THREE.HemisphereLight(0xffffff, 0x444466, 2);
    scene.add(hemiLight);
    const dirLight = new THREE.DirectionalLight(0xffffff, 3);
    dirLight.position.set(5, 10, 7);
    scene.add(dirLight);
    const rimLight = new THREE.DirectionalLight('${colorVal}', 1);
    rimLight.position.set(-5, -1, 5);
    scene.add(rimLight);

    const group = new THREE.Group();

    async function loadModel() {
      const modelPath = '${modelUrl}';
      if (modelPath) {
        try {
          const { GLTFLoader } = await import('three/addons/loaders/GLTFLoader.js');
          const loader = new GLTFLoader();
          const gltf = await loader.loadAsync(modelPath);
          const m = gltf.scene;
          m.scale.set(0.008, 0.008, 0.008);
          m.rotation.y = Math.PI;
          group.add(m);
          return;
        } catch (e) {
          console.warn('GLB load failed, using fallback geometry');
        }
      }
      const knotGeo = new THREE.TorusKnotGeometry(0.9, 0.3, 192, 36);
      const knotMat = new THREE.MeshPhysicalMaterial({
        color: '${colorVal}',
        metalness: 0.05,
        roughness: 0.25,
        clearcoat: 1,
        clearcoatRoughness: 0.15,
        emissive: '#4422aa',
        emissiveIntensity: 0.1,
      });
      const knot = new THREE.Mesh(knotGeo, knotMat);
      knot.rotation.x = Math.PI / 4;
      group.add(knot);

      const ringGeo = new THREE.TorusGeometry(1.25, 0.015, 24, 80);
      const ringMat = new THREE.MeshBasicMaterial({ color: '${colorVal}', transparent: true, opacity: 0.25 });
      const ring = new THREE.Mesh(ringGeo, ringMat);
      ring.rotation.x = Math.PI / 2.5;
      group.add(ring);
    }

    await loadModel();
    scene.add(group);

    const clock = new THREE.Clock();

    function resize() {
      const w = container.clientWidth;
      const h = container.clientHeight;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
    }
    window.addEventListener('resize', resize);

    function animate() {
      const t = clock.getElapsedTime();
      group.rotation.y = t * 0.2;
      controls.update();
      renderer.render(scene, camera);
      requestAnimationFrame(animate);
    }
    animate();
  `;
  document.body.appendChild(main);
})();
</script>

{% schema %}
{
  "name": "Fluid Distortion",
  "tag": "section",
  "class": "fluid-distortion-section",
  "limit": 1,
  "settings": [
    {
      "type": "text",
      "id": "heading_left",
      "label": "Left heading",
      "default": "smoke\nfluid",
      "info": "Use \\n for line breaks"
    },
    {
      "type": "text",
      "id": "heading_right",
      "label": "Right heading",
      "default": "beyond\nreality",
      "info": "Use \\n for line breaks"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Explore the mesmerizing intersection of smoke and fluid simulation with interactive 3D graphics. Manipulate the scene or just enjoy the flow."
    },
    {
      "type": "color",
      "id": "fluid_color",
      "label": "Fluid color",
      "default": "#1b1b1b"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#9977ff"
    },
    {
      "type": "range",
      "id": "curl",
      "label": "Curl intensity",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 30
    },
    {
      "type": "url",
      "id": "model_url",
      "label": "3D model URL (.glb)",
      "info": "Upload a GLB file to Shopify Files and paste the URL here. Leave empty for fallback geometry."
    }
  ],
  "presets": [
    {
      "name": "Fluid Distortion",
      "settings": {
        "heading_left": "smoke\nfluid",
        "heading_right": "beyond\nreality",
        "description": "Explore the mesmerizing intersection of smoke and fluid simulation with interactive 3D graphics. Manipulate the scene or just enjoy the flow.",
        "fluid_color": "#1b1b1b",
        "accent_color": "#9977ff",
        "curl": 30
      }
    }
  ]
}
{% endschema %}
