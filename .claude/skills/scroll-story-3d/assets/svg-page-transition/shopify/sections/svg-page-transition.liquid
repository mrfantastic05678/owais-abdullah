{{ 'svg-page-transition.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .svg-page-transition-overlay path {
    stroke: {{ section.settings.stroke_color }};
  }
{%- endstyle -%}

<div class="svg-page-transition-overlay" id="svg-transition-overlay">
  <svg
    width="100%"
    height="100%"
    viewBox="0 0 1316 664"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    preserveAspectRatio="xMidYMid slice"
  >
    <path
      d="M13.4746 291.27C13.4746 291.27 100.646 -18.6724 255.617 16.8418C410.588 52.356 61.0296 431.197 233.017 546.326C431.659 679.299 444.494 21.0125 652.73 100.784C860.967 180.556 468.663 430.709 617.216 546.326C765.769 661.944 819.097 48.2722 988.501 120.156C1174.21 198.957 809.424 543.841 988.501 636.726C1189.37 740.915 1301.67 149.213 1301.67 149.213"
      stroke="{{ section.settings.stroke_color }}"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      fill="none"
    />
  </svg>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const overlay = document.getElementById('svg-transition-overlay')
    const path = overlay.querySelector('path')

    const pathLength = path.getTotalLength()
    path.style.strokeDasharray = pathLength
    path.style.strokeDashoffset = pathLength

    const links = document.querySelectorAll('a[href]')

    links.forEach(function (link) {
      link.addEventListener('click', function (e) {
        const href = link.getAttribute('href')
        if (!href || href.startsWith('#') || href.startsWith('javascript')) return

        e.preventDefault()

        overlay.classList.remove('is-entering', 'is-done')
        overlay.classList.add('is-leaving')

        setTimeout(function () {
          window.location.href = href
        }, 2000)
      })
    })

    if (document.referrer) {
      overlay.classList.remove('is-leaving')
      overlay.classList.add('is-entering')
      path.style.strokeDashoffset = '0'
      path.style.strokeWidth = '2'

      setTimeout(function () {
        overlay.classList.add('is-done')
        setTimeout(function () {
          overlay.classList.remove('is-entering', 'is-done')
          path.style.strokeDashoffset = pathLength
          path.style.strokeWidth = '2'
        }, 500)
      }, 1500)
    }
  })
</script>

{% schema %}
{
  "name": "SVG Page Transition",
  "settings": [
    {
      "type": "color",
      "id": "stroke_color",
      "label": "SVG stroke color",
      "default": "#82A0FF"
    }
  ],
  "presets": [
    {
      "name": "SVG Page Transition"
    }
  ]
}
{% endschema %}
