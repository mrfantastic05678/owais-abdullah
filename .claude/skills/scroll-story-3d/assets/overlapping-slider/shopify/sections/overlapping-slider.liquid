{{ 'overlapping-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .overlapping-slider__title {
    color: {{ section.settings.title_color }};
  }
  #shopify-section-{{ section.id }} .overlapping-slider__desc {
    color: {{ section.settings.desc_color }};
  }
{%- endstyle -%}

<div class="overlapping-slider">
  <div class="overlapping-slider__left">
    <h2 class="overlapping-slider__title">{{ section.settings.title }}</h2>
    <p class="overlapping-slider__desc">{{ section.settings.description }}</p>
  </div>

  <div class="overlapping-slider__right">
    <div class="overlapping-slider__track" id="slider-track-{{ section.id }}">
      {% for block in section.blocks %}
        <div
          class="overlapping-slider__card"
          style="background-color: {{ block.settings.bg_color }};"
          data-color="{{ block.settings.bg_color }}"
        >
          <p class="overlapping-slider__card-text">{{ block.settings.text }}</p>
          <p class="overlapping-slider__card-username">{{ block.settings.username }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var track = document.getElementById('slider-track-{{ section.id }}')
    if (!track) return

    var slides = [...track.children]
    var gap = window.innerWidth * 0.02
    var slideWidth = window.innerWidth * 0.3
    var colors = slides.map(function (s) { return s.dataset.color })
    var totalWidth = slides.length * (slideWidth + gap)
    var lastSlideOffset = (slides.length - 1) * (slideWidth + gap)
    var maxScroll = totalWidth - lastSlideOffset

    var current = 0
    var target = 0
    var isDragging = false
    var startX = 0
    var startCurrent = 0
    var velocity = 0
    var momentum = 0
    var wasDragging = false
    var animId

    function setOffset() {
      return window.innerWidth * 0.5 - slideWidth
    }

    function updateSlides() {
      var vwOffset = window.innerWidth * 0.1

      slides.forEach(function (slide, i) {
        var slideLeft = slide.offsetLeft + current
        var bgColor = colors[i]
        var isLast = i === slides.length - 1

        if (slideLeft < 0 && !isLast) {
          var ratio = Math.min(1, Math.abs(slideLeft) / slideWidth)
          slide.style.cssText =
            'background-color: ' + bgColor + ';' +
            'border: 2px solid rgba(0,0,0,0.6);' +
            'transform-origin: left 80%;' +
            'transform: translateX(' + (current + Math.abs(slideLeft) + ratio * vwOffset) + 'px) rotate(' + (-15 * ratio) + 'deg) scale(' + (1 - ratio * 0.4) + ');' +
            'position: relative;' +
            'z-index: ' + (i + 1) + ';'
        } else {
          slide.style.cssText =
            'background-color: ' + bgColor + ';' +
            'border: 2px solid rgba(0, 0, 0, 0.6);' +
            'transform: translateX(' + current + 'px);' +
            'z-index: ' + (i + 1) + ';'
        }
      })
    }

    function animate() {
      current += (target - current) * 0.08
      track.style.transform = 'translateX(' + current + 'px)'
      updateSlides()

      if (Math.abs(momentum) > 0.5) {
        target += momentum
        momentum *= 0.96
        target = Math.max(-maxScroll + setOffset(), Math.min(0, target))
      }

      animId = requestAnimationFrame(animate)
    }

    track.addEventListener('mousedown', function (e) {
      isDragging = true
      wasDragging = false
      startX = e.clientX
      startCurrent = current
      velocity = 0
      momentum = 0
      track.style.cursor = 'grabbing'
    })

    document.addEventListener('mousemove', function (e) {
      if (!isDragging) return
      var dx = e.clientX - startX
      target = startCurrent + dx
      target = Math.max(-maxScroll + setOffset(), Math.min(0, target))
      velocity = dx
      wasDragging = true
    })

    document.addEventListener('mouseup', function () {
      if (isDragging) {
        isDragging = false
        track.style.cursor = 'grab'
        if (wasDragging) {
          momentum = velocity
          wasDragging = false
        }
      }
    })

    track.addEventListener('touchstart', function (e) {
      isDragging = true
      wasDragging = false
      startX = e.touches[0].clientX
      startCurrent = current
      velocity = 0
      momentum = 0
    }, { passive: true })

    document.addEventListener('touchmove', function (e) {
      if (!isDragging) return
      var dx = e.touches[0].clientX - startX
      target = startCurrent + dx
      target = Math.max(-maxScroll + setOffset(), Math.min(0, target))
      velocity = dx
      wasDragging = true
    }, { passive: true })

    document.addEventListener('touchend', function () {
      if (isDragging) {
        isDragging = false
        if (wasDragging) {
          momentum = velocity
          wasDragging = false
        }
      }
    })

    track.addEventListener('selectstart', function (e) { e.preventDefault() })

    animate()
  })
</script>

{% schema %}
{
  "name": "Overlapping Slider",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Star<br/>Inspired"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "A collection of wisdom from great minds to fuel your daily motivation"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "desc_color",
      "label": "Description color",
      "default": "#000000"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Quote text",
          "default": "Inspirational quote goes here."
        },
        {
          "type": "text",
          "id": "username",
          "label": "Username",
          "default": "@username"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Card background color",
          "default": "#FFFFFF"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Overlapping Slider",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "text": "Success is not final, failure is not fatal: it is the courage to continue that counts.",
            "username": "@john_doe",
            "bg_color": "#FFFF00"
          }
        },
        {
          "type": "slide",
          "settings": {
            "text": "The only way to do great work is to love what you do.",
            "username": "@jane_smith",
            "bg_color": "#55DB9C"
          }
        },
        {
          "type": "slide",
          "settings": {
            "text": "Believe you can and you're halfway there.",
            "username": "@mike_wilson",
            "bg_color": "#E9CCFF"
          }
        }
      ]
    }
  ]
}
{% endschema %}
