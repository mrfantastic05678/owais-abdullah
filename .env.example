# ==============================================================================
# Owais Abdullah - Portfolio & Autonomous AI Systems
# Complete Environment Variables Reference (.env.example)
#
# Instructions:
# 1. Copy this file to '.env.local' (git-ignored, never commit real secrets).
#    cp .env.example .env.local
# 2. Fill in your private credentials below.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Administrative Security Credentials
# ------------------------------------------------------------------------------
# Authorized Superadmin Email
# Used to verify administrative logins and to receive secure 1-click unlock and password reset links.
ADMIN_EMAIL=your_email@example.com

# Master Password for Administrative Access
# Set your desired private password here. You can also change or reset it anytime via the email magic link.
ADMIN_PASSWORD=your_secure_password_here

# Legacy alias fallback for ADMIN_PASSWORD (optional, leave blank or match ADMIN_PASSWORD)
ANALYTICS_PASSWORD=


# ------------------------------------------------------------------------------
# 2. Sanity Headless CMS Configuration
# ------------------------------------------------------------------------------
# Your Sanity Project ID (found at https://www.sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id

# Target dataset name (typically 'production')
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API Version (default: 2024-01-01)
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Sanity Write / Deploy Token (requires Editor or Administrator role for updating telemetry & metrics)
SANITY_API_TOKEN=your_sanity_write_api_token_here

# Secret token used by Sanity GROQ webhooks to trigger on-demand page revalidations (/api/revalidate)
SANITY_REVALIDATE_SECRET=your_sanity_revalidate_secret_here

# Fallback alias for SANITY_REVALIDATE_SECRET (optional)
REVALIDATE_SECRET=


# ------------------------------------------------------------------------------
# 3. AI & LLM Services (Otto Assistant & Autonomous Agents)
# ------------------------------------------------------------------------------
# Google Gemini API Key (obtain from https://aistudio.google.com/)
# Used by /api/chat for intelligent visitor assistance and portfolio navigation
GEMINI_API_KEY=your_gemini_api_key_here

# Enable WebRTC Live Voice interaction for the Otto AI agent (set 'true' to enable, 'false' to disable)
LIVE_VOICE_ENABLED=false

# Optional: Custom Gemini Edge Router URL (if proxying LLM requests through a dedicated gateway)
# GEMINI_ROUTER_URL=https://your-custom-router.example.com/api

# Optional: Bearer token for the custom Gemini Router proxy (if GEMINI_ROUTER_URL is set)
# GFR_TOKEN=your_router_bearer_token_here


# ------------------------------------------------------------------------------
# 4. Database (Neon Serverless Postgres - Drizzle ORM)
# ------------------------------------------------------------------------------
# Postgres connection string for Store Directory, Comments, Chat Sessions, and Admin Settings
# Obtain from https://console.neon.tech/
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require"


# ------------------------------------------------------------------------------
# 5. Email & Notification Services (Resend)
# ------------------------------------------------------------------------------
# Resend API Key (obtain from https://resend.com/api-keys)
# Used to dispatch contact form submissions, magic access links, and password reset tokens
RESEND_API_KEY=re_your_resend_api_key_here

# Verified Sender Email Identity (e.g. "Owais Abdullah <contact@yourdomain.com>")
RESEND_FROM_EMAIL="Owais Abdullah <contact@yourdomain.com>"

# Destination Email where contact form inquiries and leads will be delivered
CONTACT_TO_EMAIL=your_contact_destination_email@example.com


# ------------------------------------------------------------------------------
# 6. SEO, Indexing & Web Analytics
# ------------------------------------------------------------------------------
# Google Analytics 4 Measurement ID (e.g. "G-XXXXXXXXXX")
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# IndexNow Key for instant URL submission to search engines (Bing, Yandex, Naver)
# Generate a 32-character hex key at https://www.bing.com/indexnow
INDEXNOW_KEY=your_indexnow_key_here
